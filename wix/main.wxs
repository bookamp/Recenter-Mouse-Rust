<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Recenter Mouse"
           Manufacturer="bookamp"
           Version="1.0.0"
           UpgradeCode="7E54C64D-5D9E-4CEE-8D2A-E4BA4668D37B"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Recenter Mouse">
        <Component Id="MainExecutable" Guid="3E492B45-FDF3-4F93-A332-9F1C7718BAE4">
          <File Id="RecenterMouseExe" Source="target/release/recenter-mouse.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Recenter Mouse">
        <Component Id="ApplicationShortcut" Guid="85A48F9A-400A-4F3D-8822-1A7D1739D163">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Recenter Mouse"
                    Description="Recenter mouse cursor and active window to primary display"
                    Target="[!RecenterMouseExe]"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\bookamp\RecenterMouse" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Recenter Mouse" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="wix/license.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="assets/dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets/banner.bmp" />
  </Package>
</Wix>
